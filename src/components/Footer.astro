---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[var(--color-line)] bg-[var(--color-paper-2)]">
  <div class="wrap py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="text-[var(--color-ink)]"><Logo /></div>
        <p class="mt-4 max-w-xs text-[0.95rem] text-[var(--color-ink-2)]">
          {site.tagline}. We build the systems that do the repetitive work a business
          currently does by hand.
        </p>
        <p class="eyebrow mt-6">An agency within {site.parent}</p>
      </div>

      <div>
        <p class="eyebrow mb-4">Site</p>
        <ul class="grid gap-y-1.5 gap-x-8 sm:grid-cols-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="inline-flex min-h-6 items-center text-[0.95rem] link-underline">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/contact/" class="inline-flex min-h-6 items-center text-[0.95rem] link-underline">Contact</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-4">Get in touch</p>
        <a href={`mailto:${site.email}`} aria-label={`Email ${site.name} at ${site.email}`} class="inline-flex min-h-6 items-center text-[0.95rem] link-underline">{site.email}</a>
        <div class="mt-4 flex gap-4">
          {site.linkedin && (
            <a href={site.linkedin} rel="noopener nofollow" target="_blank" aria-label="LinkedIn" class="text-[var(--color-ink-3)] hover:text-[var(--color-ink)] transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          )}
          {site.twitter && (
            <a href={site.twitter} rel="noopener nofollow" target="_blank" aria-label="X" class="text-[var(--color-ink-3)] hover:text-[var(--color-ink)] transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 9.24h-3.308l-7.475-8.652-7.41 8.652H3.256l7.954-8.637L3.256 2.25h3.308l7.41 8.652 8.126-9.24z"/></svg>
            </a>
          )}
          {site.instagram && (
            <a href={site.instagram} rel="noopener nofollow" target="_blank" aria-label="Instagram" class="text-[var(--color-ink-3)] hover:text-[var(--color-ink)] transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
          )}
        </div>
      </div>
    </div>

    <hr class="rule my-10" />
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <p class="font-[var(--font-mono)] text-[0.72rem] tracking-[0.04em] text-[var(--color-ink-3)]">
        © {year} {site.name}. All rights reserved.
      </p>

      {/*
        Legal links live in the footer rather than the main nav: buyers look for
        them here, and a privacy policy that exists but cannot be found does
        none of the trust work it is there to do.
      */}
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li>
          <a href="/privacy/" class="font-[var(--font-mono)] text-[0.72rem] tracking-[0.04em] text-[var(--color-ink-3)] link-underline">
            Privacy
          </a>
        </li>
        <li>
          <a href="/terms/" class="font-[var(--font-mono)] text-[0.72rem] tracking-[0.04em] text-[var(--color-ink-3)] link-underline">
            Terms
          </a>
        </li>
      </ul>

      <p class="font-[var(--font-mono)] text-[0.72rem] tracking-[0.04em] text-[var(--color-ink-3)]">
        Built to keep running after we leave.
      </p>
    </div>
  </div>
</footer>