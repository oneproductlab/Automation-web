---
/*
  FAQ
  ---
  The answer-engine surface. Each question is a real heading and each answer is
  written to stand alone if it is lifted out of the page, which is what featured
  snippets and generative engines actually quote.

  Rendered as native <details> so it works without JavaScript, is keyboard
  accessible for free, and stays fully readable to crawlers even when collapsed.
*/
interface Item {
  q: string;
  a: string;
}
interface Props {
  items: Item[];
  title?: string;
  eyebrow?: string;
}

const { items, title = 'Common questions', eyebrow = 'FAQ' } = Astro.props;
---

<!--
  Slightly tighter top padding than a standalone section would take: this always
  follows a section that already ends in generous bottom padding, and stacking
  both reads as a dead gap rather than as breathing room.
-->
<section class="wrap border-t border-[var(--color-line)] py-14 md:py-16">
  <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="mt-4 text-3xl md:text-4xl">{title}</h2>
    </div>

    <div class="border-t border-[var(--color-line)]">

      {
        items.map((item) => (
          <details class="faq group border-b border-[var(--color-line)]">
            <summary class="faq__q">
              <h3 class="faq__heading">{item.q}</h3>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:focus-visible {
    outline: 2px solid var(--color-signal);

    outline-offset: 2px;
  }
  .faq__heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.3;
    margin: 0;
    transition: color 0.18s ease;
  }
  .faq__q:hover .faq__heading {
    color: var(--color-signal-ink);
  }

  /* A plus that becomes a minus — no icon library, no layout shift. */
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-top: 0.35rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    background: var(--color-ink-3);
    transition: transform 0.22s ease, opacity 0.22s ease;
  }
  .faq__icon::before {
    inset-inline: 0;
    top: 50%;
    height: 1.5px;

    transform: translateY(-50%);
  }
  .faq__icon::after {
    inset-block: 0;
    left: 50%;
    width: 1.5px;
    transform: translateX(-50%);
  }
  .faq[open] .faq__icon::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }
  .faq[open] .faq__icon::before {
    background: var(--color-signal);
  }

  .faq__a {
    padding-bottom: 1.25rem;
    max-width: 60ch;
  }
  .faq__a p {
    margin: 0;
    color: var(--color-ink-2);
    font-size: 1rem;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq[open] .faq__a {
      animation: faq-open 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>