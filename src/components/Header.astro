---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="border-b border-[var(--color-line)] bg-[var(--color-paper)]/95 sticky top-0 z-40 backdrop-blur-[2px]">

  <div class="wrap flex items-center justify-between h-16">
    <a href="/" class="text-[var(--color-ink)]" aria-label={`${site.name} — home`}>
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-6" aria-label="Primary">
      {
        /*
          Every item carries a resting hairline, not just the active one.

          Bare mono text at 0.8rem with no underline and no colour difference
          from body copy read as a row of labels rather than a row of links —
          people reported not knowing the nav was clickable. The rule sits at
          the same offset in all three states, so hover and current-page only
          change its weight and colour and nothing shifts.
        */
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact/" class="btn btn-primary">Book a call</a>
      <button
        type="button"
        class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-line)] text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-signal)] hover:text-[var(--color-signal-ink)]"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Switch to dark mode"
        title="Switch to dark mode"
      >
        <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.5 15.3A8.5 8.5 0 0 1 8.7 3.5 8.5 8.5 0 1 0 20.5 15.3Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" stroke-linecap="round" />
        </svg>
      </button>
    </nav>

    <div class="flex items-center gap-4 md:hidden">
      <button
        type="button"
        class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-line)] text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-signal)] hover:text-[var(--color-signal-ink)]"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Switch to dark mode"
        title="Switch to dark mode"
      >
        <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20.5 15.3A8.5 8.5 0 0 1 8.7 3.5 8.5 8.5 0 1 0 20.5 15.3Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" stroke-linecap="round" />
        </svg>
      </button>

      <details id="menu" class="relative">
        <summary
          class="list-none cursor-pointer font-[var(--font-mono)] text-[0.8rem] tracking-[0.05em] uppercase select-none py-2"

          aria-label="Menu"
        >
          Menu
        </summary>
        <div class="absolute right-0 top-full mt-2 w-60 border border-[var(--color-line)] bg-[var(--color-paper)] shadow-lg p-2">

          {
            nav.map((item) => (
              <a
                href={item.href}
                class="nav-link nav-link--stacked"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a href="/contact/" class="block px-3 py-2.5 mt-1 font-[var(--font-mono)] text-[0.85rem] bg-[var(--color-ink)] text-[var(--color-paper)] text-center">

            Book a call
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // `<details>` gives us a working menu with no JavaScript, but not the dismissal
  // behavior people expect from one. Escape and outside-click are added here so
  // the menu never traps a user who opened it by accident.
  const menu = document.querySelector('#menu') as HTMLDetailsElement | null;

  if (menu) {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.open = false;
      }
    });
  }

  const storageKey = 'flowzora-theme';

  function storedTheme(): string {
    try {
      const saved = localStorage.getItem(storageKey);
      if (saved === 'dark' || saved === 'light') return saved;
    } catch {
      // Private browsing or disabled storage falls through to the current DOM state.
    }

    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateThemeControls(theme: string) {
    const isDark = theme === 'dark';
    document.documentElement.dataset.theme = theme;

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(isDark));
      button.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      button.title = isDark ? 'Switch to light mode' : 'Switch to dark mode';
    });

    // Re-queried every time: view transitions swap in a fresh <head>, so a
    // reference captured on first load points at a discarded element.
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', isDark ? '#17150f' : '#f4f1ea');
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest('[data-theme-toggle]');
    if (!button) return;

    const nextTheme = storedTheme() === 'dark' ? 'light' : 'dark';

    try {
      localStorage.setItem(storageKey, nextTheme);
    } catch {
      // The theme still changes for this visit if storage is unavailable.
    }

    updateThemeControls(nextTheme);
  });

  /*
    A view-transition swap resets the attributes on <html> to whatever the
    incoming document shipped, which drops `data-theme` and silently returns
    the page to light. The pre-paint script in the layout does not re-run
    (identical inline scripts are not re-executed), so the theme is reapplied
    here after every navigation.
  */
  document.addEventListener('astro:after-swap', () => updateThemeControls(storedTheme()));

  updateThemeControls(storedTheme());
</script>
