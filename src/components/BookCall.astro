---
/*
  BookCall
  --------
  Shared link to the team's external booking page.
*/
import { site } from '../data/site';

interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Book a call' } = Astro.props;
---

{
  <div class={className}>
    <a
      href={site.bookingUrl}
      class="btn btn-ghost"
    >
      {label}
    </a>
  </div>
}
