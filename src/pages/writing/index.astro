---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Workflow Automation Case Studies"
  description="Practical notes on workflow automation, integrations and where AI genuinely helps — from a workflow automation studio."

  ogRoute="writing"
>
  <section class="wrap pt-10 pb-12 md:pt-14">
    <Breadcrumbs trail={[]} current="Writing" />
    <p class="eyebrow mt-8">Writing</p>
    <h1 class="mt-5 max-w-3xl text-[2.4rem] leading-[1.05] md:text-[3.4rem]">
      Notes on systems that don't need babysitting.
    </h1>
    <p class="mt-7 max-w-xl text-lg text-[var(--color-ink-2)]">
      Practical writing about automation, integrations, and where AI actually
      earns its place.
    </p>
  </section>

  <section class="wrap pb-16">
    <ul class="reveal border-t border-[var(--color-line)]">
      {
        posts.map((post, i) => (
          <li data-stagger style={`--i:${i}`} class="border-b border-[var(--color-line)]">

            <a
              href={`/writing/${post.id}/`}
              class="group grid gap-3 py-9 md:grid-cols-[10rem_1fr] md:gap-10"
            >
              <p class="font-[var(--font-mono)] text-xs text-[var(--color-ink-3)]">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              </p>
              <div>
                <h2 class="font-[var(--font-display)] text-2xl transition-colors group-hover:text-[var(--color-signal-ink)]">

                  {post.data.title}
                </h2>
                <p class="mt-2 max-w-2xl text-[var(--color-ink-2)]">{post.data.description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((t) => (
                    <span class="font-[var(--font-mono)] text-[0.68rem] uppercase tracking-[0.1em] text-[var(--color-ink-3)]">

                      #{t}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-[var(--color-line)]">
    <div class="wrap py-20 text-center md:py-24">
      <h2 class="mx-auto max-w-2xl text-3xl md:text-4xl">Rather we just built it?</h2>
      <a href="/contact/" class="btn btn-primary mt-8">Have us build it</a>

    </div>
  </section>
</Base>