---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist." noindex={true}>
  <section class="wrap py-32 text-center">
    <p class="eyebrow">404</p>

    <h1 class="mt-6 text-4xl md:text-5xl">This page was never built.</h1>
    <p class="mx-auto mt-5 max-w-md text-[var(--color-ink-2)]">
      The link is broken, or the page has moved.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back home</a>
      <a href="/services/" class="btn btn-ghost">What we build</a>
    </div>
  </section>
</Base>