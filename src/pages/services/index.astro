---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { services, site } from '../../data/site';

const description =
  'Flowzora builds workflow automation for growing teams: CRM and revenue operations, marketing lifecycle, back-office process automation, support triage, systems integration, and AI agents used only where they earn their place.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.domain}/services/#page`,
    name: 'Workflow automation services',
    description,
    isPartOf: { '@id': `${site.domain}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: services.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.seoTitle,
        url: `${site.domain}/services/${s.slug}/`,
      })),

    },
  },
];

const faqs = [
  {
    q: 'What does a workflow automation studio actually do?',
    a: 'We map how work moves through your business today, then build the systems that carry it automatically — connecting the tools you already run, removing the manual steps between them, and handing over documentation so your team owns the result.',

  },
  {
    q: 'Do we have to replace our existing tools?',
    a: 'Almost never. Most operational problems are integration problems, not tooling problems, so we build around the stack you already pay for. We only recommend replacing something when it genuinely cannot do the job.',

  },
  {
    q: 'Where do most companies start?',
    a: 'With one workflow that visibly costs the team time — usually lead intake, onboarding or an approval chain. A single well-chosen system pays for itself and makes the next one easier to scope.',

  },
];
---

<Base title="Workflow automation services" description={description} ogRoute="services" schema={schema}>

  <section class="wrap pt-10 pb-14 md:pt-14">
    <Breadcrumbs trail={[]} current="Services" />

    <p class="eyebrow mt-8">Services</p>
    <h1 class="mt-5 max-w-3xl text-[2.4rem] leading-[1.05] md:text-[3.4rem]">
      We start from the problem, not the tool.
    </h1>
    <p class="mt-7 max-w-2xl text-lg text-[var(--color-ink-2)]">

      Every engagement is a system built around how your business actually works.
      Here's where that work usually lands.
    </p>
    <!--
      A price signal this high up is deliberate. Services is a likely search
      landing page, and it previously carried no cost information at all — so a
      reader could work through the whole page without being able to answer
      "can I afford this", which is the question that decides whether they
      contact anyone.
    -->
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="/pricing/" class="btn btn-ghost">Builds from $8,000 · see pricing</a>
    </div>
  </section>

  <section class="wrap pb-8">
    <ul class="reveal grid gap-px bg-[var(--color-line)] border-y border-[var(--color-line)] md:grid-cols-2">

      {
        services.map((s, i) => (
          <li data-stagger style={`--i:${i}`} class="bg-[var(--color-paper)]">
            <a
              href={`/services/${s.slug}/`}
              class="group flex h-full flex-col p-7 transition-colors hover:bg-[var(--color-paper-2)] md:p-9"

            >
              <span class="font-[var(--font-mono)] text-sm text-[var(--color-ink-3)]">{s.index}</span>
              <h2 class="mt-3 font-[var(--font-display)] text-2xl transition-colors group-hover:text-[var(--color-signal-ink)] md:text-[1.75rem]">

                {s.title}
              </h2>
              <p class="mt-3 max-w-md text-[0.98rem] text-[var(--color-ink-2)]">{s.brief}</p>
              <span class="mt-6 inline-flex items-center gap-2 font-[var(--font-mono)] text-[0.8rem] text-[var(--color-ink-3)] transition-colors group-hover:text-[var(--color-signal-ink)]">


                How this works
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq items={faqs} />

  <section class="border-t border-[var(--color-line)]">
    <div class="wrap py-20 text-center md:py-24">
      <h2 class="mx-auto max-w-2xl text-3xl md:text-4xl">Not sure which of these you need?</h2>
      <p class="mx-auto mt-5 max-w-xl text-[var(--color-ink-2)]">
        Most people don't, at first. That's what the mapping conversation is for.
      </p>
      <a href="/contact/" class="btn btn-primary mt-8">Tell us the bottleneck</a>
    </div>
  </section>
</Base>