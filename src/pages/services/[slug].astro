---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { services, site, pricing } from '../../data/site';
import { getWork } from '../../lib/work';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Cross-link services to proof. Related work keeps each service page from being
// a dead end and spreads authority through the site rather than pooling it.
const work = (await getWork()).slice(0, 2);

const others = services.filter((s) => s.slug !== service.slug);
const entry = pricing[0];

const schema = [
  {
    '@type': 'Service',
    '@id': `${site.domain}/services/${service.slug}/#service`,
    name: service.seoTitle,
    alternateName: service.title,
    description: service.answer,
    serviceType: service.keyword,
    provider: { '@id': `${site.domain}/#organization` },
    areaServed: site.areaServed,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: entry.priceValue,
      description: `${entry.name} — ${entry.duration}, credited against a build.`,
      url: `${site.domain}/pricing/`,
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `${service.title} — what that includes`,
      itemListElement: service.builds.map((b) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: b },
      })),
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `${site.domain}/services/${service.slug}/#faq`,
    mainEntity: service.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!--
  The meta description is `summary`, not `answer`.

  The two fields pull in opposite directions: `answer` is written to be a
  complete, quotable response for answer engines and runs 230–290 characters,
  which a search result truncates mid-sentence. `summary` says the same thing
  inside the ~155 characters a SERP shows. `answer` still carries the AEO
  weight in the Service and FAQPage schema, where length is an advantage
  rather than a cost.
-->
<Base
  title={service.seoTitle}
  description={service.summary}
  ogRoute="services"
  schema={schema}
>
  <section class="wrap pt-10 pb-12 md:pt-14">
    <Breadcrumbs trail={[{ label: 'Services', href: '/services/' }]} current={service.title} />

    <p class="eyebrow mt-8">Service {service.index}</p>
    <h1 class="mt-5 max-w-3xl text-[2.4rem] leading-[1.05] md:text-[3.4rem]">
      {service.title}
    </h1>

    <!-- Answer-first: the snippet-eligible paragraph sits directly under the H1. -->
    <p class="mt-7 max-w-2xl text-lg text-[var(--color-ink-2)]">{service.answer}</p>

    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a href="/contact/" class="btn btn-primary">Tell us the bottleneck</a>
      <a href="/pricing/" class="btn btn-ghost">What it costs</a>
    </div>
  </section>

  <!-- Qualification: help the reader self-identify before we sell anything. -->
  <section class="border-y border-[var(--color-line)] bg-[var(--color-paper-2)]">
    <div class="wrap py-14 md:py-16">
      <p class="eyebrow">You probably need this if</p>
      <ul class="reveal mt-7 grid gap-px bg-[var(--color-line)] sm:grid-cols-3">
        {
          service.signals.map((signal, i) => (
            <li data-stagger style={`--i:${i}`} class="bg-[var(--color-paper-2)] p-5 sm:p-6">
              <p class="font-[var(--font-mono)] text-xs text-[var(--color-ink-3)]">
                {String(i + 1).padStart(2, '0')}
              </p>
              <p class="mt-2 text-[0.98rem] text-[var(--color-ink-2)]">{signal}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">What we build</p>
        <h2 class="mt-4 text-3xl md:text-4xl">How this works in practice.</h2>
        <p class="mt-5 max-w-md text-[var(--color-ink-2)]">{service.detail}</p>
      </div>
      <ul class="reveal space-y-0 border-t border-[var(--color-line)]">
        {
          service.builds.map((build, i) => (
            <li data-stagger style={`--i:${i}`} class="flex gap-4 border-b border-[var(--color-line)] py-4">
              <span class="font-[var(--font-mono)] text-[var(--color-signal)]" aria-hidden="true">—</span>
              <span class="text-[0.98rem] text-[var(--color-ink-2)]">{build}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq items={service.faqs} title={`Questions about ${service.title.toLowerCase()}`} />

  {
    work.length > 0 && (
      <section class="wrap border-t border-[var(--color-line)] py-16 md:py-20">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p class="eyebrow">Related work</p>
            <h2 class="mt-4 text-3xl md:text-4xl">Systems like this, written up.</h2>
          </div>
          <a href="/work/" class="btn btn-ghost">All work</a>
        </div>
        <div class="mt-10 grid gap-px bg-[var(--color-line)] md:grid-cols-2">
          {work.map((item) => (
            <a
              href={`/work/${item.id}/`}
              class="group block bg-[var(--color-paper)] p-7 transition-colors hover:bg-[var(--color-paper-2)]"
            >
              <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.12em] text-[var(--color-ink-3)]">
                {item.data.kind.replace('-', ' ')} · {item.data.sector}
              </p>
              <h3 class="mt-3 font-[var(--font-display)] text-xl group-hover:text-[var(--color-signal-ink)]">
                {item.data.title}
              </h3>
              <p class="mt-2 text-[0.95rem] text-[var(--color-ink-2)]">{item.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap border-t border-[var(--color-line)] py-14 md:py-16">
    <p class="eyebrow">Other services</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        others.map((other) => (
          <li>
            <a
              href={`/services/${other.slug}/`}
              class="inline-block border border-[var(--color-line)] px-3.5 py-2 font-[var(--font-mono)] text-[0.8rem] text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-ink)] hover:text-[var(--color-ink)]"
            >
              {other.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-[var(--color-line)]">
    <div class="wrap py-20 text-center md:py-24">
      <h2 class="mx-auto max-w-2xl text-3xl md:text-4xl">Tell us what’s still done by hand.</h2>
      <p class="mx-auto mt-5 max-w-xl text-[var(--color-ink-2)]">
        One workflow, honestly described. We’ll tell you whether it’s worth automating.
      </p>
      <a href="/contact/" class="btn btn-primary mt-8">Map this workflow</a>
    </div>
  </section>
</Base>
