---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import { Image } from 'astro:assets';
import founderPhoto from '../assets/images/niraj.jpg';
import { site, founder } from '../data/site';

const principles = [
  {
    title: 'The simplest mechanism that works',
    body: 'A rule beats a model when a rule will do. We use the least clever thing that reliably does the job, because operations reward boring reliability.',
  },
  {
    title: 'Legible by default',
    body: 'If a system can’t be drawn, explained and handed over, it isn’t finished. Documentation is part of the build, not an afterthought.',
  },
  {
    title: 'Honest about evidence',
    body: 'We label internal builds as exactly that, and every figure says where it came from. We’d rather show real, sourced results than borrowed credibility.',
  },
  {
    title: 'Built to be left',
    body: 'Success is the automation running quietly long after we’ve gone — owned and understood by your team, not dependent on us.',
  },
];

const description = `${site.name} is a workflow automation agency under ${site.parent}, founded by ${founder.name}. We build automated systems teams can see, trust and own.`;

const faqs = [
  {
    q: 'How big is the team?',
    a: 'Deliberately focused. Engagements are led by the founder and delivered with a handful of engineers, which means the person who scopes your system is the person accountable for building it. We take on fewer projects than a volume agency and stay closer to each one.',
  },
  {
    q: 'What track record is behind the work?',
    a: 'Years of production engineering. The founder has spent his career building backend and machine learning systems that run unattended at scale — financial analytics platforms, data pipelines and applied ML research. That experience is what every engagement is built on, and everything published on this site is labeled honestly for what it is.',
  },
  {
    q: 'What is oneProductLab?',
    a: 'oneProductLab is the parent organization Flowzora operates under. Flowzora is the agency focused specifically on operations and workflow automation.',
  },
];
---

<Base title="About the agency and its founder" description={description} ogRoute="about">
  <section class="wrap pt-10 pb-12 md:pt-14">
    <Breadcrumbs trail={[]} current="About" />

    <p class="eyebrow mt-8">About</p>
    <h1 class="mt-5 max-w-3xl text-[2.4rem] leading-[1.05] md:text-[3.4rem]">
      An automation agency that builds the systems businesses run on.
    </h1>
    <p class="mt-7 max-w-2xl text-lg text-[var(--color-ink-2)]">
      {site.name} is a workflow automation agency under {site.parent}. We work with
      startups, SMBs and growing teams who’ve outgrown manual process but don’t
      want another rigid platform to fight against.
    </p>
  </section>

  <!-- The founder entity. A named, checkable person is what makes an agency
       credible to buyers and citable by search and answer engines. -->
  <section class="border-y border-[var(--color-line)] bg-[var(--color-paper-2)]">
    <div class="wrap py-14 md:py-20">
      <p class="eyebrow">Who you’ll work with</p>
      <div class="mt-8 grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:items-start">
        <div>
          {/* Processed at build time: WebP with a JPEG fallback, sized to the slot. */}
          <Image
            src={founderPhoto}
            alt={founder.photo.alt}
            widths={[320, 640]}
            sizes="(min-width: 768px) 20rem, 100vw"
            loading="lazy"
            class="aspect-[4/5] w-full max-w-xs border border-[var(--color-line)] bg-[var(--color-paper-2)] object-cover"
          />
          <p class="mt-4 font-[var(--font-display)] text-xl">{founder.name}</p>
          <p class="font-[var(--font-mono)] text-xs uppercase tracking-[0.1em] text-[var(--color-ink-3)]">
            {founder.role}
          </p>
          <a
            href={founder.linkedin}
            rel="me noopener"
            target="_blank"
            class="mt-3 inline-block font-[var(--font-mono)] text-[0.8rem] link-underline"
          >
            LinkedIn ↗
          </a>
        </div>

        <div>
          <h2 class="text-3xl md:text-4xl">Founder-led, and hands-on.</h2>
          <p class="mt-5 max-w-2xl text-[var(--color-ink-2)]">{founder.bio}</p>
          <p class="mt-4 max-w-2xl text-[var(--color-ink-2)]">
            Engagements are led and built by the same person who scopes them.
            That’s the whole reason we can promise systems you’ll
            actually be able to maintain.
          </p>

          <div class="mt-8 grid gap-8 sm:grid-cols-2">
            <div>
              <p class="eyebrow">Sectors worked in</p>
              <ul class="mt-3 space-y-1.5">
                {founder.sectors.map((s) => <li class="text-[0.95rem] text-[var(--color-ink-2)]">{s}</li>)}
              </ul>
            </div>
            <div>
              <p class="eyebrow">Capabilities</p>
              <ul class="mt-3 space-y-1.5">
                {
                  founder.capabilities.map((s) => (
                    <li class="text-[0.95rem] text-[var(--color-ink-2)]">{s}</li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr]">
      <h2 class="text-3xl md:text-4xl">What we believe</h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {
          principles.map((p) => (
            <div class="border-t border-[var(--color-line)] pt-4">
              <h3 class="font-[var(--font-display)] text-xl">{p.title}</h3>
              <p class="mt-2 text-[0.98rem] text-[var(--color-ink-2)]">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Faq items={faqs} title="Questions about the agency" />

  <section class="wrap py-14 md:py-16">
    <div class="grid gap-6 border-t border-[var(--color-line)] pt-8 sm:grid-cols-3">
      <div>
        <p class="eyebrow">Based</p>
        <p class="mt-2 text-[var(--color-ink-2)]">{site.location}</p>
      </div>
      <div>
        <p class="eyebrow">Part of</p>
        <a
          href={site.parentUrl}
          rel="noopener"
          target="_blank"
          class="mt-2 inline-block link-underline text-[var(--color-ink-2)]"
        >
          {site.parent} ↗
        </a>
      </div>
      <div>
        <p class="eyebrow">Contact</p>
        <a href={`mailto:${site.email}`} aria-label={`Email ${site.name} at ${site.email}`} class="mt-2 inline-block link-underline text-[var(--color-ink-2)]">
          {site.email}
        </a>
      </div>
    </div>
  </section>

  <!--
    Testimonials belong on About more than anywhere else: this is the page a
    buyer opens when they are deciding whether to trust the person, and third
    parties vouching is worth more here than any amount of self-description.
  -->
  <Testimonials heading="People who’ve worked with Niraj." eyebrow="References" />

  <section class="border-t border-[var(--color-line)]">
    <div class="wrap py-20 text-center md:py-24">
      <h2 class="mx-auto max-w-2xl text-3xl md:text-4xl">Tell us what’s still done by hand.</h2>
      <a href="/contact/" class="btn btn-primary mt-8">Talk to Niraj</a>
    </div>
  </section>
</Base>
